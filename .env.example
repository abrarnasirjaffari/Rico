# ==========================================
# Rico Environment Configuration
# ==========================================

# 1. PayPal Developer Sandbox Credentials
# Get your Sandbox keys from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_MCP_SERVER_URL=https://mcp.sandbox.paypal.com/sse
# Optional: "mock" runs the simulator (never with live), "real" requires credentials.
# Required for a simulator demo when NODE_ENV=production.
# PAYPAL_MODE=mock
# Optional per-request timeout in milliseconds (default 30000).
# PAYPAL_TIMEOUT_MS=30000

# Required in production: signs session cookies. Payment routes refuse requests without it.
# AUTH_SECRET=
# Required to accept Telegram button callbacks (also needs TELEGRAM_CHAT_ID).
# TELEGRAM_WEBHOOK_SECRET=
# The one Rico user ID that the Telegram chat belongs to. Callbacks act as this user.
# TELEGRAM_OWNER_ID=
# Bearer secret for POST /api/cron/sentinel, at least 32 characters. Unset means scheduled audits are refused.
# CRON_SECRET=

# 2. Local Persistent Storage (SQLite)
DATABASE_URL=./sqlite.db
# "sqlite" (default) or "postgres". PostgreSQL mode never falls back to SQLite.
# DATABASE_PROVIDER=sqlite
# Must stay unset until real captures are explicitly approved.
# PAYPAL_REAL_PAYMENTS_APPROVED=

# 3. Google Gemini 3.8 Flash (LLM Reasoning)
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. PostHog Observability & Guardrail Telemetry
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=your_posthog_project_id

# 5. Dual-Rail Smart Payment Rails (PayPal Primary + Visa/Mastercard via PayPal Vault)
